{
  "name": "sif-point-batara",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node build_worker.mjs && node scripts/copy-public.mjs",
    "test": "node build_worker.mjs && node --no-warnings test/api.test.mjs && node --no-warnings test/worker.test.mjs && node --no-warnings test/vercel.test.mjs",
    "dev": "node --no-warnings dev/server.mjs",
    "db:setup:tidb": "node db/setup-tidb.mjs",
    "smoke:vercel": "node scripts/smoke-vercel.mjs",
    "prebuild": "node scripts/extract-inline-images.mjs && node scripts/extract-inline-code.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.3.0",
    "mysql2": "^3.24.6"
  }
}
